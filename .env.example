# Panel-only default: enable OpenAI-compatible providers, disable bundled Ollama.
# Set OPENAI_API_BASE_URL to your custom OpenAI-compatible endpoint.
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ENABLE_OPENAI_API=true
ENABLE_OLLAMA_API=false

# Optional: only needed if you later enable the Ollama integration manually.
OLLAMA_BASE_URL=http://localhost:11434

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN=*

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS=*

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Docker Compose defaults for running this repository locally
OPEN_WEBUI_PORT=3000
WEBUI_SECRET_KEY=
# Keep the first Docker build lighter by downloading ML assets on demand at runtime.
# Set to false if you prefer the image build to pre-download those assets.
USE_SLIM=true
